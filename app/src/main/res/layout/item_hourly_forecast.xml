<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutHourlyContainer"
    android:layout_width="76dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_hourly_card_normal"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="6dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/tvHourlyTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/brand_subtitle"
        android:textSize="12sp"
        tools:text="Bây giờ" />

    <ImageView
        android:id="@+id/ivHourlyIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginVertical="6dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_weather_illustration" />

    <TextView
        android:id="@+id/tvHourlyTemp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/card_title"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="28°C" />

    <TextView
        android:id="@+id/tvHourlyPop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/stat_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="15% mưa" />

</LinearLayout>
