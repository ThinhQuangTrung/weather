<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true"
    android:focusableInTouchMode="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="100dp">

        <!-- ================= TOP HEADER ================= -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trang chủ"
            android:textColor="@color/card_title"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/layoutUnitToggle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/layoutUnitToggle" />

        <!-- Unit Toggle Container (°C / °F) -->
        <LinearLayout
            android:id="@+id/layoutUnitToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_unit_toggle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp"
            app:layout_constraintEnd_toStartOf="@id/btnSettings"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/btnCelsius"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_unit_toggle_active"
                android:gravity="center"
                android:text="°C"
                android:textColor="@color/unit_toggle_text_active"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFahrenheit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:text="°F"
                android:textColor="@color/unit_toggle_text_inactive"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Settings Button -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="6dp"
            android:src="@drawable/ic_settings"
            app:layout_constraintBottom_toBottomOf="@id/layoutUnitToggle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layoutUnitToggle"
            app:tint="@color/brand_subtitle" />

        <!-- ================= LOCATION CARD ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:elevation="1dp"
            android:padding="14dp"
            app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

            <!-- Location Icon Badge -->
            <FrameLayout
                android:id="@+id/flLocationBadge"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_rounded"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_location"
                    app:tint="@color/stat_primary" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/llLocationInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnFavorite"
                app:layout_constraintStart_toEndOf="@id/flLocationBadge"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLocationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hanoi, VN"
                        android:textColor="@color/card_title"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/stat_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLastUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="🕒 Cập nhật lúc 09:30 AM"
                    android:textColor="@color/brand_section_title"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge_rounded"
                android:padding="8dp"
                android:src="@drawable/ic_star"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/brand_section_title" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= MAIN WEATHER HERO CARD ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardHeroWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero_weather_card"
            android:elevation="2dp"
            android:paddingVertical="20dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardLocation">

            <!-- Top Weather Condition Pill -->
            <LinearLayout
                android:id="@+id/layoutConditionPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivConditionIconSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_uv"
                    app:tint="@color/badge_orange_icon" />

                <TextView
                    android:id="@+id/tvConditionDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quang đãng • Clear Sky"
                    android:textColor="@color/brand_title"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Big Weather Icon from OpenWeatherMap CDN / Local -->
            <ImageView
                android:id="@+id/ivWeatherMainIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_uv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutConditionPill" />

            <!-- Big Temperature -->
            <LinearLayout
                android:id="@+id/layoutTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="top|center_horizontal"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivWeatherMainIcon">

                <TextView
                    android:id="@+id/tvMainTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="28"
                    android:textColor="@color/hero_temp_color"
                    android:textSize="64sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMainTempUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="4dp"
                    android:text="°C"
                    android:textColor="@color/hero_temp_unit"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Feels Like -->
            <TextView
                android:id="@+id/tvFeelsLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cảm giác như 30°C"
                android:textColor="@color/hero_card_text_secondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutTemp" />

            <!-- High / Low Pill -->
            <LinearLayout
                android:id="@+id/layoutHighLowPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hero_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFeelsLike">

                <TextView
                    android:id="@+id/tvTempHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↑ Cao: 32°"
                    android:textColor="@color/badge_orange_icon"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/card_border" />

                <TextView
                    android:id="@+id/tvTempLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↓ Thấp: 24°"
                    android:textColor="@color/stat_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= TELEMETRY SECTION TITLE ================= -->
        <TextView
            android:id="@+id/tvTelemetrySectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Chỉ số chi tiết"
            android:textColor="@color/card_title"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHeroWeather" />

        <!-- ================= 2x2 TELEMETRY GRID ================= -->
        <LinearLayout
            android:id="@+id/layoutTelemetryRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvTelemetrySectionTitle">

            <!-- Card 1: Độ ẩm -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardHumidity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvHumidityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Độ ẩm"
                    android:textColor="@color/telemetry_title"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:padding="6dp"
                    android:src="@drawable/ic_humidity"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/badge_humidity_icon" />

                <TextView
                    android:id="@+id/tvHumidityVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="68%"
                    android:textColor="@color/telemetry_value"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHumidityLabel" />

                <TextView
                    android:id="@+id/tvDewPoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Điểm sương: 21°C"
                    android:textColor="@color/telemetry_subtitle"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHumidityVal" />

                <ProgressBar
                    android:id="@+id/pbHumidity"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="68"
                    android:progressDrawable="@drawable/bg_progress_humidity"
                    app:layout_constraintTop_toBottomOf="@id/tvDewPoint" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 2: Tốc độ gió -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardWind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvWindLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tốc độ gió"
                    android:textColor="@color/telemetry_title"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:padding="6dp"
                    android:src="@drawable/ic_wind"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/badge_wind_icon" />

                <TextView
                    android:id="@+id/tvWindSpeedVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="4.2 m/s"
                    android:textColor="@color/telemetry_value"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWindLabel" />

                <TextView
                    android:id="@+id/tvWindDirectionDegree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_tag"
                    android:backgroundTint="@color/pill_wind_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="↗ 120° ESE"
                    android:textColor="@color/pill_wind_text"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvWindSpeedVal"
                    app:layout_constraintVertical_bias="1.0" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTelemetryRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/layoutTelemetryRow1">

            <!-- Card 3: Tầm nhìn -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardVisibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvVisLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tầm nhìn"
                    android:textColor="@color/telemetry_title"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:padding="6dp"
                    android:src="@drawable/ic_visibility"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/badge_vis_icon" />

                <TextView
                    android:id="@+id/tvVisibilityVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="10 km"
                    android:textColor="@color/telemetry_value"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVisLabel" />

                <TextView
                    android:id="@+id/tvVisibilityDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tầm nhìn rất tốt"
                    android:textColor="@color/telemetry_subtitle"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVisibilityVal" />

                <TextView
                    android:id="@+id/tvVisibilityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_tag"
                    android:backgroundTint="@color/pill_vis_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Rõ nét"
                    android:textColor="@color/pill_vis_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVisibilityDesc" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 4: Áp suất -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPressure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvPressureLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Áp suất"
                    android:textColor="@color/telemetry_title"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:padding="6dp"
                    android:src="@drawable/ic_gauge"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/badge_press_icon" />

                <TextView
                    android:id="@+id/tvPressureVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="1012 hPa"
                    android:textColor="@color/telemetry_value"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPressureLabel" />

                <TextView
                    android:id="@+id/tvPressureDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ổn định bình thường"
                    android:textColor="@color/telemetry_subtitle"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPressureVal" />

                <TextView
                    android:id="@+id/tvPressureAtmBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_tag"
                    android:backgroundTint="@color/pill_press_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="1.00 atm"
                    android:textColor="@color/pill_press_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPressureDesc" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- ================= SUN & DAY CYCLE CARD ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardSunCycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:elevation="1dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTelemetryRow2">

            <ImageView
                android:id="@+id/ivSunHorizonIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sunrise"
                app:layout_constraintBottom_toBottomOf="@id/tvSunCycleTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvSunCycleTitle"
                app:tint="@color/stat_secondary" />

            <TextView
                android:id="@+id/tvSunCycleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Mặt trời &amp; Chu kỳ ngày"
                android:textColor="@color/card_title"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/ivSunHorizonIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTimezone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hà Nội (UTC+7)"
                android:textColor="@color/brand_section_title"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/tvSunCycleTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvSunCycleTitle" />

            <!-- Arc Path Custom View -->
            <com.example.weather.ui.home.SunPathView
                android:id="@+id/sunPathView"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvSunCycleTitle" />

            <!-- Sunrise / Daylight / Sunset Info Row -->
            <LinearLayout
                android:id="@+id/layoutSunTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/sunPathView">

                <!-- Sunrise (Left) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/sun_badge_bg"
                        android:padding="6dp"
                        android:src="@drawable/ic_sunrise"
                        app:tint="@color/sun_badge_icon" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bình minh"
                            android:textColor="@color/telemetry_title"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSunriseTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="05:42 AM"
                            android:textColor="@color/card_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Daylight Duration (Center) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDaylightDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12h 33m"
                        android:textColor="@color/stat_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Thời gian\nchiếu sáng"
                        android:textColor="@color/telemetry_title"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Sunset (Right) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hoàng hôn"
                            android:textColor="@color/telemetry_title"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSunsetTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18:15 PM"
                            android:textColor="@color/card_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/moon_badge_bg"
                        android:padding="6dp"
                        android:src="@drawable/ic_moon"
                        app:tint="@color/moon_badge_icon" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Loading Progress -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/stat_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
