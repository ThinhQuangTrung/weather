<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Circular Icon Container -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_forecast_icon_circle">

        <ImageView
            android:id="@+id/ivDailyIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_weather_illustration" />
    </FrameLayout>

    <!-- Day and Condition Description -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDailyDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/card_title"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Hôm nay" />

        <TextView
            android:id="@+id/tvDailyDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/brand_section_title"
            android:textSize="13sp"
            tools:text="Mây rải rác" />
    </LinearLayout>

    <!-- Temp Range and Chevron -->
    <TextView
        android:id="@+id/tvDailyTempRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:textColor="@color/card_title"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="24°C - 31°C" />

    <ImageView
        android:id="@+id/ivDailyArrow"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/brand_section_title" />

</LinearLayout>
