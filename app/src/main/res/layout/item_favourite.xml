<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardFavourite"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white"
    android:elevation="1dp"
    android:foreground="?attr/selectableItemBackground"
    android:padding="14dp">

    <!-- Weather Icon Badge (Left) -->
    <FrameLayout
        android:id="@+id/flIconBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_forecast_icon_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivWeatherIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_cloud"
            app:tint="@color/stat_primary" />
    </FrameLayout>

    <!-- City & Condition Info -->
    <LinearLayout
        android:id="@+id/llCityInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/llTempInfo"
        app:layout_constraintStart_toEndOf="@id/flIconBadge"
        app:layout_constraintTop_toTopOf="parent">

        <!-- City Name + Country Code Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/card_title"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Hà Nội" />

            <TextView
                android:id="@+id/tvCountryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_tag"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:textColor="@color/tag_gray_text"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="VN" />
        </LinearLayout>

        <!-- Condition description & Wind -->
        <TextView
            android:id="@+id/tvWeatherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/card_desc"
            android:textSize="12sp"
            tools:text="Mây rải rác • Gió nhẹ 12 km/h" />
    </LinearLayout>

    <!-- Temperature Info (Right) -->
    <LinearLayout
        android:id="@+id/llTempInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ivFavorite"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/card_title"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="28°C" />

        <TextView
            android:id="@+id/tvTempSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/card_desc"
            android:textSize="12sp"
            tools:text="Thấp: 24°" />
    </LinearLayout>

    <!-- Favorite Heart Button -->
    <ImageView
        android:id="@+id/ivFavorite"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/favourite"
        android:padding="5dp"
        android:src="@drawable/favorite_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#EF4444" />

</androidx.constraintlayout.widget.ConstraintLayout>