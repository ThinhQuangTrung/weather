<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="100dp">

        <!-- ================= LOCATION CARD ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:elevation="1dp"
            android:padding="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Location Icon Badge -->
            <FrameLayout
                android:id="@+id/flLocationBadge"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_rounded"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_location"
                    app:tint="@color/stat_primary" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/llLocationInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/addCity"
                app:layout_constraintStart_toEndOf="@id/flLocationBadge"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLocationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hanoi, VN"
                        android:textColor="@color/card_title"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/stat_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLastUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="🕒 Cập nhật lúc 09:30 AM"
                    android:textColor="@color/brand_section_title"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Add City Button (Plus icon) -->
            <ImageView
                android:id="@+id/addCity"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge_rounded"
                android:padding="8dp"
                android:src="@drawable/ic_add"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/stat_primary" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= MAIN WEATHER HERO CARD ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardHeroWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero_weather_card"
            android:elevation="2dp"
            android:paddingVertical="20dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardLocation">

            <!-- Top Weather Condition Pill -->
            <LinearLayout
                android:id="@+id/layoutConditionPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivConditionIconSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_uv"
                    app:tint="@color/badge_orange_icon" />

                <TextView
                    android:id="@+id/tvConditionDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quang đãng • Clear Sky"
                    android:textColor="@color/brand_title"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Big Weather Icon from OpenWeatherMap CDN / Local -->
            <ImageView
                android:id="@+id/ivWeatherMainIcon"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="14dp"
                android:src="@drawable/ic_uv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutConditionPill" />

            <!-- Big Temperature -->
            <LinearLayout
                android:id="@+id/layoutTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="top|center_horizontal"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivWeatherMainIcon">

                <TextView
                    android:id="@+id/tvMainTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="28"
                    android:textColor="@color/hero_temp_color"
                    android:textSize="64sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMainTempUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="2dp"
                    android:text="°C"
                    android:textColor="@color/hero_temp_unit"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Feels Like -->
            <TextView
                android:id="@+id/tvFeelsLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cảm giác như 30°C"
                android:textColor="@color/hero_card_text_secondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutTemp" />

            <!-- Temperature High / Low Range -->
            <LinearLayout
                android:id="@+id/layoutTempHighLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvFeelsLike">

                <TextView
                    android:id="@+id/tvTempHigh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/badge_orange_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="↑ Cao: 32°"
                    android:textColor="@color/badge_orange_icon"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTempLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/badge_blue_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="↓ Thấp: 24°"
                    android:textColor="@color/stat_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= TELEMETRY SECTION TITLE ================= -->
        <TextView
            android:id="@+id/tvTelemetrySectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/telemetry_section_title"
            android:textColor="@color/brand_section_title"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHeroWeather" />

        <!-- ================= ROW 1: HUMIDITY & WIND ================= -->
        <LinearLayout
            android:id="@+id/layoutTelemetryRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvTelemetrySectionTitle">

            <!-- Humidity Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardHumidity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="14dp">

                <FrameLayout
                    android:id="@+id/flHumidityBadge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/badge_humidity_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_humidity"
                        app:tint="@color/badge_humidity_icon" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvHumidityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Độ ẩm"
                    android:textColor="@color/telemetry_title"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/flHumidityBadge"
                    app:layout_constraintStart_toEndOf="@id/flHumidityBadge"
                    app:layout_constraintTop_toTopOf="@id/flHumidityBadge" />

                <TextView
                    android:id="@+id/tvHumidityVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="72%"
                    android:textColor="@color/telemetry_value"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/flHumidityBadge" />

                <ProgressBar
                    android:id="@+id/pbHumidity"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="72"
                    android:progressDrawable="@drawable/bg_progress_humidity"
                    app:layout_constraintTop_toBottomOf="@id/tvHumidityVal" />

                <TextView
                    android:id="@+id/tvDewPoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Điểm sương: 22°C"
                    android:textColor="@color/telemetry_subtitle"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/pbHumidity" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Wind Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardWind"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="14dp">

                <FrameLayout
                    android:id="@+id/flWindBadge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/badge_wind_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_wind"
                        app:tint="@color/badge_wind_icon" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvWindTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Gió"
                    android:textColor="@color/telemetry_title"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/flWindBadge"
                    app:layout_constraintStart_toEndOf="@id/flWindBadge"
                    app:layout_constraintTop_toTopOf="@id/flWindBadge" />

                <TextView
                    android:id="@+id/tvWindSpeedVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="14 m/s"
                    android:textColor="@color/telemetry_value"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/flWindBadge" />

                <TextView
                    android:id="@+id/tvWindDirectionDegree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/pill_wind_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="↗ ĐB 45°"
                    android:textColor="@color/pill_wind_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWindSpeedVal" />

                <TextView
                    android:id="@+id/tvWindGust"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Gió giật: Êm dịu"
                    android:textColor="@color/telemetry_subtitle"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWindDirectionDegree" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- ================= ROW 2: VISIBILITY & PRESSURE ================= -->
        <LinearLayout
            android:id="@+id/layoutTelemetryRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/layoutTelemetryRow1">

            <!-- Visibility Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardVisibility"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="14dp">

                <FrameLayout
                    android:id="@+id/flVisBadge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/badge_vis_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_visibility"
                        app:tint="@color/badge_vis_icon" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvVisibilityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Tầm nhìn"
                    android:textColor="@color/telemetry_title"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/flVisBadge"
                    app:layout_constraintStart_toEndOf="@id/flVisBadge"
                    app:layout_constraintTop_toTopOf="@id/flVisBadge" />

                <TextView
                    android:id="@+id/tvVisibilityVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="10 km"
                    android:textColor="@color/telemetry_value"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/flVisBadge" />

                <TextView
                    android:id="@+id/tvVisibilityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/pill_vis_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Rõ ràng"
                    android:textColor="@color/pill_vis_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVisibilityVal" />

                <TextView
                    android:id="@+id/tvVisibilityDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tầm nhìn xa tốt"
                    android:textColor="@color/telemetry_subtitle"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvVisibilityBadge" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Pressure Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPressure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_white"
                android:elevation="1dp"
                android:padding="14dp">

                <FrameLayout
                    android:id="@+id/flPressBadge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/badge_press_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_gauge"
                        app:tint="@color/badge_press_icon" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPressureTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Áp suất"
                    android:textColor="@color/telemetry_title"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/flPressBadge"
                    app:layout_constraintStart_toEndOf="@id/flPressBadge"
                    app:layout_constraintTop_toTopOf="@id/flPressBadge" />

                <TextView
                    android:id="@+id/tvPressureVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="1012 hPa"
                    android:textColor="@color/telemetry_value"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/flPressBadge" />

                <TextView
                    android:id="@+id/tvPressureAtmBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/pill_press_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="1.00 atm"
                    android:textColor="@color/pill_press_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPressureVal" />

                <TextView
                    android:id="@+id/tvPressureDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Áp suất ổn định"
                    android:textColor="@color/telemetry_subtitle"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvPressureAtmBadge" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- ================= AIR QUALITY CARD (AQI) ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardAirQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_white"
            android:elevation="1dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTelemetryRow2">

            <!-- AQI Title Row -->
            <FrameLayout
                android:id="@+id/flAqiBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/badge_blue_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_air_quality"
                    app:tint="@color/stat_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvAirQualityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/air_quality_title"
                android:textColor="@color/telemetry_title"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/flAqiBadge"
                app:layout_constraintStart_toEndOf="@id/flAqiBadge"
                app:layout_constraintTop_toTopOf="@id/flAqiBadge" />

            <TextView
                android:id="@+id/tvAirQualityVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="42 AQI"
                android:textColor="@color/telemetry_value"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/flAqiBadge" />

            <TextView
                android:id="@+id/tvAirQualityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="#E8F8F0"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Tốt"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvAirQualityVal"
                app:layout_constraintStart_toEndOf="@id/tvAirQualityVal"
                app:layout_constraintTop_toTopOf="@id/tvAirQualityVal" />

            <ProgressBar
                android:id="@+id/pbAirQuality"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:max="5"
                android:progress="1"
                android:progressDrawable="@drawable/bg_progress_humidity"
                android:progressTint="#10B981"
                app:layout_constraintTop_toBottomOf="@id/tvAirQualityVal" />

            <TextView
                android:id="@+id/tvAirQualityDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chất lượng không khí lý tưởng, an toàn cho mọi hoạt động ngoài trời."
                android:textColor="@color/telemetry_subtitle"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/pbAirQuality" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ================= SUN & DAY CYCLE CARD ================= -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardSunCycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_white"
            android:elevation="1dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardAirQuality">

            <!-- Sun Cycle Header -->
            <FrameLayout
                android:id="@+id/flSunCycleBadge"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/badge_orange_bg"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sunrise"
                    app:tint="@color/badge_orange_icon" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvSunCycleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Mặt trời &amp; Chu kỳ ngày"
                android:textColor="@color/telemetry_title"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/flSunCycleBadge"
                app:layout_constraintStart_toEndOf="@id/flSunCycleBadge"
                app:layout_constraintTop_toTopOf="@id/flSunCycleBadge" />

            <!-- Custom Sun Path Arc View -->
            <com.example.weather.ui.home.SunPathView
                android:id="@+id/sunPathView"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvSunCycleTitle" />

            <!-- Sunrise / Daylight / Sunset Info Row -->
            <LinearLayout
                android:id="@+id/layoutSunTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/sunPathView">

                <!-- Sunrise (Left) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/sun_badge_bg"
                        android:padding="6dp"
                        android:src="@drawable/ic_sunrise"
                        app:tint="@color/sun_badge_icon" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bình minh"
                            android:textColor="@color/telemetry_title"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSunriseTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="05:42 AM"
                            android:textColor="@color/card_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Daylight Duration (Center) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDaylightDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12h 33m"
                        android:textColor="@color/stat_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Thời gian\nchiếu sáng"
                        android:textColor="@color/telemetry_title"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Sunset (Right) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hoàng hôn"
                            android:textColor="@color/telemetry_title"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSunsetTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18:15 PM"
                            android:textColor="@color/card_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_rounded"
                        android:backgroundTint="@color/moon_badge_bg"
                        android:padding="6dp"
                        android:src="@drawable/ic_moon"
                        app:tint="@color/moon_badge_icon" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Loading Progress -->
        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/stat_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
